# ============================================================================
# Access Provisioning & Audit Portal — manual API requests
#
# Open in VS Code with the REST Client extension (humao.rest-client), or in
# IntelliJ / WebStorm, which have an HTTP client built in. Click "Send Request"
# above any block below.
#
# @base points at the API directly. Switch to @proxy to exercise the same
# same-origin path the browser uses through nginx.
# ============================================================================

@base  = http://localhost:3000
@proxy = http://localhost:8080/api

# --- Seeded actors (see db/migrations/002_seed.sql) -------------------------
@ada       = 11111111-1111-4111-8111-111111111111
@grace     = 22222222-2222-4222-8222-222222222222
@alan      = 33333333-3333-4333-8333-333333333333
@katherine = 44444444-4444-4444-8444-444444444444
@margaret  = 55555555-5555-4555-8555-555555555555
@barbara   = 66666666-6666-4666-8666-666666666666

# Ada, Grace  → admin
# Alan        → support
# Katherine   → support, viewer
# Margaret    → viewer
# Barbara     → no roles


###############################################################################
# Health
###############################################################################

### Health check — no actor header required
GET {{base}}/health


###############################################################################
# Current actor
###############################################################################

### Who am I, and what may I do — as an admin
GET {{base}}/me
X-Actor-Id: {{ada}}

### Same, as a viewer — expect a much shorter permission list
GET {{base}}/me
X-Actor-Id: {{margaret}}

### No actor header — expect 401
GET {{base}}/me

### Unknown actor — expect 401
GET {{base}}/me
X-Actor-Id: 99999999-9999-4999-8999-999999999999

### Malformed actor id — expect 400
GET {{base}}/me
X-Actor-Id: not-a-uuid


###############################################################################
# Users
###############################################################################

### List users and the roles they hold — as an admin
GET {{base}}/users
X-Actor-Id: {{ada}}

### Same, as a viewer — users:read is enough
GET {{base}}/users
X-Actor-Id: {{margaret}}

### No roles, so no users:read — expect 403
GET {{base}}/users
X-Actor-Id: {{barbara}}

### Create a user — expect 201 and an empty roles array
POST {{base}}/users
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "email": "radia.perlman@example.com", "displayName": "Radia Perlman" }

### Send the block above twice — the second is a 409, email_taken
POST {{base}}/users
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "email": "RADIA.PERLMAN@example.com", "displayName": "Radia Perlman" }

### Email is trimmed and lowercased before it is stored
POST {{base}}/users
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "email": "  Sophie.Wilson@Example.COM  ", "displayName": "  Sophie Wilson  " }

### Invalid email and empty display name — expect 400 naming both fields
POST {{base}}/users
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "email": "not-an-email", "displayName": "" }

### Unrecognised field — expect 400, roles are granted by their own endpoint
POST {{base}}/users
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "email": "karen.jones@example.com", "displayName": "Karen Sparck Jones", "roles": ["admin"] }

### Support may read users but not create them — expect 403
POST {{base}}/users
X-Actor-Id: {{alan}}
Content-Type: application/json

{ "email": "shafi.goldwasser@example.com", "displayName": "Shafi Goldwasser" }


###############################################################################
# Roles
###############################################################################

### Grant Barbara two roles — the body is the whole set she should end up with
PUT {{base}}/users/{{barbara}}/roles
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "roles": ["support", "viewer"] }

### Send that again — 200, and nothing is written to the audit log
PUT {{base}}/users/{{barbara}}/roles
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "roles": ["support", "viewer"] }

### Revoke support by leaving it out, keeping viewer
PUT {{base}}/users/{{barbara}}/roles
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "roles": ["viewer"] }

### Revoke everything
PUT {{base}}/users/{{barbara}}/roles
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "roles": [] }

### A role that does not exist — expect 400 naming it
PUT {{base}}/users/{{barbara}}/roles
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "roles": ["wizard"] }

### Malformed user id — expect 400
PUT {{base}}/users/not-a-uuid/roles
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "roles": ["viewer"] }

### No such user — expect 404
PUT {{base}}/users/99999999-9999-4999-8999-999999999999/roles
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "roles": ["viewer"] }

### Support holds neither roles:grant nor roles:revoke — expect 403
PUT {{base}}/users/{{barbara}}/roles
X-Actor-Id: {{alan}}
Content-Type: application/json

{ "roles": ["viewer"] }

### Demote Grace, leaving Ada the only user who can manage access
PUT {{base}}/users/{{grace}}/roles
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "roles": ["viewer"] }

### Now demote Ada — expect 409, and Ada keeps admin
PUT {{base}}/users/{{ada}}/roles
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "roles": ["viewer"] }

### Put Grace back
PUT {{base}}/users/{{grace}}/roles
X-Actor-Id: {{ada}}
Content-Type: application/json

{ "roles": ["admin"] }
